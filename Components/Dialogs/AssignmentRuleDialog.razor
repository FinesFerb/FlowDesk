@using FlowDesk.Web.Data
@using MudBlazor
@inject IAdminService AdminService
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Новое правило маршрутизации</MudText>
    </TitleContent>
    <DialogContent>
        <MudSelect T="int" @bind-Value="_model.CategoryId" Label="Категория" Variant="Variant.Outlined" Class="mb-4">
            @foreach (var category in Categories)
            {
                <MudSelectItem T="int" Value="@category.Id">@category.Name</MudSelectItem>
            }
        </MudSelect>
        <MudSelect T="Guid" @bind-Value="_model.ExecutorId" Label="Исполнитель" Variant="Variant.Outlined" Class="mb-4">
            @foreach (var executor in Executors)
            {
                <MudSelectItem T="Guid" Value="@executor.Id">@executor.FullName</MudSelectItem>
            }
        </MudSelect>
        <MudNumericField @bind-Value="_model.SortOrder" Label="Приоритет правила" Variant="Variant.Outlined" Min="0" Class="mb-4" />
        <MudSwitch @bind-Value="_model.IsActive" Label="Правило активно" Color="Color.Primary" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text">Отмена</MudButton>
        <MudButton OnClick="SaveAsync" Variant="Variant.Filled" Color="Color.Primary" Disabled="_saving">Сохранить</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired]
    public IReadOnlyList<CategoryDto> Categories { get; set; } = [];

    [Parameter, EditorRequired]
    public IReadOnlyList<ApplicationUser> Executors { get; set; } = [];

    private readonly SaveAssignmentRuleDto _model = new();
    private bool _saving;

    protected override void OnInitialized()
    {
        if (Categories.Count > 0)
        {
            _model.CategoryId = Categories[0].Id;
        }
        if (Executors.Count > 0)
        {
            _model.ExecutorId = Executors[0].Id;
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SaveAsync()
    {
        if (_model.CategoryId == 0 || _model.ExecutorId == Guid.Empty)
        {
            Snackbar.Add("Выберите категорию и исполнителя.", Severity.Warning);
            return;
        }

        _saving = true;
        try
        {
            await AdminService.CreateAssignmentRuleAsync(_model);
            Snackbar.Add("Правило создано.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }
}
